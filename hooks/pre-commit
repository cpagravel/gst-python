#!/bin/bash

# Pre-commit hook to run formatting and type checking

# Exit on any error
set -e

# Run global git hooks first if they exist
GLOBAL_HOOKS_PATH=$(git config --global core.hooksPath 2>/dev/null || echo "")
if [ -n "$GLOBAL_HOOKS_PATH" ] && [ -f "$GLOBAL_HOOKS_PATH/pre-commit" ]; then
    echo "Running global pre-commit hook from $GLOBAL_HOOKS_PATH..."
    "$GLOBAL_HOOKS_PATH/pre-commit"
fi

echo "Running local pre-commit checks..."

# Get list of Python files to be committed
PYTHON_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)

if [ -z "$PYTHON_FILES" ]; then
    echo "No Python files to check."
    exit 0
fi

echo "Checking Python files: $PYTHON_FILES"

# Check if required tools are installed
if ! command -v mypy &> /dev/null; then
    echo "Error: mypy is not installed. Run: pip install mypy"
    exit 1
fi

if ! command -v ruff &> /dev/null; then
    echo "Error: ruff is not installed. Run: pip install ruff"
    exit 1
fi

if ! command -v pytest &> /dev/null; then
    echo "Error: pytest is not installed. Run: pip install pytest"
    exit 1
fi

# Run ruff formatter (with 2-space indentation)
echo "Running ruff formatter..."
ruff format $PYTHON_FILES
if [ $? -ne 0 ]; then
    echo "Ruff formatting failed."
    exit 1
fi

# Re-add formatted files to staging
git add $PYTHON_FILES

# Run ruff linter (includes PEP8 naming conventions)
echo "Running ruff linter..."
ruff check $PYTHON_FILES
if [ $? -ne 0 ]; then
    echo "Linting failed. Please fix the issues above."
    exit 1
fi

# Run mypy type checker
echo "Running mypy type checker..."
mypy $PYTHON_FILES
if [ $? -ne 0 ]; then
    echo "Type checking failed. Please fix the issues above."
    exit 1
fi

# Run unit tests
echo "Running unit tests..."
pytest tests/
if [ $? -ne 0 ]; then
    echo "Unit tests failed. Please fix the issues above."
    exit 1
fi

echo "All pre-commit checks passed!"